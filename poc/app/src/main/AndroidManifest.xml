<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AAOS vehicle speed (PERF_VEHICLE_SPEED) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Pleos Vehicle SDK: Brake / Gear (CAR_DRIVE), Airbag / Telltale (CAR_SAFETY) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- Pleos TextToSpeech: without it the TTS SDK throws SecurityException (found on Pleos Connect Emulator 2.1.0) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Pleos NaviHelper: route + waypoint (scene A) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="SafeLog PoC"
        tools:ignore="MissingApplicationIcon">

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Demo mode: replays a scenario CSV through the real core engine. No Pleos SDK use. -->
        <activity
            android:name=".DemoActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Live mode on the Pleos Connect Emulator: real Pleos SDK signals (Virtual Console / VHAL). -->
        <activity
            android:name=".LiveActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <service
            android:name=".SafeLogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="driving safety monitoring (vehicle signals)" />
        </service>
    </application>
</manifest>
