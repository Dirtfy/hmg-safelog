[{"id": "n4a619476", "lang": "ko", "voice": "narrator", "text": "콘솔 화면이 멈춰 새로고침했고, 그 부분은 잘랐습니다.", "speed": 1.15}, {"id": "n79c25716", "lang": "ko", "voice": "narrator", "text": "콘솔에서 오른쪽 깜빡이를 켜면, 앱이 바로 말합니다.", "speed": 1.15}, {"id": "n87e2a4e4", "lang": "ko", "voice": "narrator", "text": "빨간불에도 멈춘 뒤 우회전할 수 있다는 뜻입니다.", "speed": 1.15}, {"id": "n3ecbccd8", "lang": "ko", "voice": "narrator", "text": "장면 씨. 고속도로 요금소로 갑니다.", "speed": 1.15}, {"id": "n7958bd0c", "lang": "ko", "voice": "narrator", "text": "가속 패드로 시속 80킬로까지 올립니다.", "speed": 1.15}, {"id": "n799d5514", "lang": "ko", "voice": "narrator", "text": "요금소 1킬로미터 전, 앱이 말합니다.", "speed": 1.15}, {"id": "nba6d84cb", "lang": "ko", "voice": "narrator", "text": "파란 하이패스 차로는 단말기 있는 차만 갑니다.", "speed": 1.15}, {"id": "ne68a448b", "lang": "ko", "voice": "narrator", "text": "없으면 현금이나 카드 차로를 쓰라는 안내입니다.", "speed": 1.15}, {"id": "n7e4dcc5d", "lang": "ko", "voice": "narrator", "text": "요금소 앞에서 속도를 줄이고 멈춥니다.", "speed": 1.15}, {"id": "n03a5e662", "lang": "ko", "voice": "narrator", "text": "콘솔에서 기어를 피로 바꿉니다.", "speed": 1.15}, {"id": "n53b7751a", "lang": "ko", "voice": "narrator", "text": "주차하면 오늘 들은 규칙을 일본어 카드로 봅니다.", "speed": 1.15}, {"id": "n4dc041b1", "lang": "ko", "voice": "narrator", "text": "운전 중에는 말로만, 멈췄을 때만 화면으로.", "speed": 1.15}, {"id": "nfb6c281d", "lang": "ko", "voice": "narrator", "text": "한 번만, 짧게, 그 직전에. 드라이브코리아였습니다.", "speed": 1.15}, {"id": "adaf25b6ae", "lang": "en", "voice": "app", "text": "School zone ahead: 30 kilometers per hour, cameras enforce it twenty four seven.", "speed": 1.0}, {"id": "a2629368c6", "lang": "en", "voice": "app", "text": "Right turn on red is allowed after a full stop; stop for pedestrians on the crosswalk (fine 60,000 won).", "speed": 1.0}, {"id": "a5ddb0bb6c", "lang": "en", "voice": "app", "text": "Toll gate ahead: blue Hi-pass lanes are for cars with a Hi-pass unit; check with your rental company, otherwise use the cash/card lane.", "speed": 1.0}]