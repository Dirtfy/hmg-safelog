[{"id": "nd7cbb805", "lang": "ko", "voice": "narrator", "text": "드라이브코리아, 외국인 운전자를 위한 앱입니다.", "speed": 1.15}, {"id": "n6d13de14", "lang": "ko", "voice": "narrator", "text": "일본에서 온 여행자가 서울에서 렌터카를 몹니다.", "speed": 1.15}, {"id": "n97b14214", "lang": "ko", "voice": "narrator", "text": "한국에만 있는 규칙을 직전에 한 문장으로 알려 줍니다.", "speed": 1.15}, {"id": "n8bad0f1a", "lang": "ko", "voice": "narrator", "text": "모두 플레오스 에뮬레이터에서 실제로 실행한 화면입니다.", "speed": 1.15}, {"id": "n1c005467", "lang": "ko", "voice": "narrator", "text": "GPS 위치는 가짜 경로를 만들어 직접 넣었습니다.", "speed": 1.15}, {"id": "n7e621977", "lang": "ko", "voice": "narrator", "text": "영어 목소리는 앱 문장을 다른 TTS로 다시 읽힌 것입니다.", "speed": 1.15}, {"id": "n4fc52ab2", "lang": "ko", "voice": "narrator", "text": "장면 에이. 어린이 보호구역으로 다가갑니다.", "speed": 1.15}, {"id": "n39633c50", "lang": "ko", "voice": "narrator", "text": "콘솔의 가속 패드를 눌러 출발합니다.", "speed": 1.15}, {"id": "n4a619476", "lang": "ko", "voice": "narrator", "text": "콘솔 화면이 멈춰 새로고침했고, 그 부분은 잘랐습니다.", "speed": 1.15}, {"id": "n88704703", "lang": "ko", "voice": "narrator", "text": "보호구역 300미터 전, 앱이 말합니다.", "speed": 1.15}, {"id": "nbde36411", "lang": "ko", "voice": "narrator", "text": "시속 30킬로, 24시간 단속이라는 뜻입니다.", "speed": 1.15}, {"id": "n9a59c342", "lang": "ko", "voice": "narrator", "text": "일본어 음성이 없어 영어로 말하게 했습니다.", "speed": 1.15}, {"id": "n767a05ed", "lang": "ko", "voice": "narrator", "text": "운전자가 시속 30킬로로 속도를 줄입니다.", "speed": 1.15}, {"id": "n119ad722", "lang": "ko", "voice": "narrator", "text": "장면 비. 교차로에서 오른쪽으로 돕니다.", "speed": 1.15}, {"id": "n8640f971", "lang": "ko", "voice": "narrator", "text": "가속 패드로 시속 35킬로까지 올립니다.", "speed": 1.15}]